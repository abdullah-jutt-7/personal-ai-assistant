{
  "name": "personalaiasisstant",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace frontend",
    "build:web": "npm run build --workspace frontend",
    "start:web": "npm run start --workspace frontend",
    "dev:api": "python -m backend.app.main",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "package:preview": "npm run build:web && powershell.exe -ExecutionPolicy Bypass -File scripts/package-preview.ps1",
    "preview": "powershell.exe -ExecutionPolicy Bypass -File scripts/run-preview.ps1",
    "preview:stop": "powershell.exe -ExecutionPolicy Bypass -File scripts/stop-preview.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
