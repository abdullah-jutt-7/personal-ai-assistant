# environments
venv/
env/
.env

# Python caching
__pycache__/
*.py[cod]
*$py.class

# IDEs
.idea/
.vscode/

# OS generated files
.DS_Store
Thumbs.db

# Large Models / Data
# (The base tinyllama model is ~2.2GB, so it should not be committed. Users will run download_tinyllama.py)
models/base_models/*
!models/base_models/.gitkeep

