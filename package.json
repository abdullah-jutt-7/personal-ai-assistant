{
  "name": "personalaiasisstant",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace frontend",
    "build:web": "npm run build --workspace frontend",
    "start:web": "npm run start --workspace frontend",
    "dev:api": "python -m backend.app.main",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "build:host": "powershell.exe -ExecutionPolicy Bypass -File scripts/build-webview2-host.ps1",
    "package:preview": "npm run build:web && powershell.exe -ExecutionPolicy Bypass -File scripts/package-preview.ps1",
    "preview": "powershell.exe -ExecutionPolicy Bypass -File scripts/run-preview.ps1",
    "preview:stop": "powershell.exe -ExecutionPolicy Bypass -File scripts/stop-preview.ps1",
    "backend:stop": "powershell.exe -ExecutionPolicy Bypass -File scripts/stop-app.ps1 -Mode backend -RootPath .",
    "all:stop": "powershell.exe -ExecutionPolicy Bypass -File scripts/all-stop.ps1",
    "build:installer": "npm run package:preview && powershell.exe -ExecutionPolicy Bypass -File scripts/build-installer.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
